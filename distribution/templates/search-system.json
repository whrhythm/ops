{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "search-system"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "searxng-settings-v5",
        "namespace": "search-system"
      },
      "data": {
        "settings.yml": "use_default_settings:\n  engines:\n    keep_only: [360search, mwmbl, bing, yandex]\nengines:\n  - {name: 360search, disabled: false}\n  - {name: mwmbl, disabled: false}\n  - {name: bing, disabled: false, base_url: 'https://cn.bing.com'}\n  - {name: yandex, disabled: false, timeout: 2.8, weight: 0.7}\nserver:\n  limiter: false\n  public_instance: false\n  image_proxy: false\nsearch:\n  formats: [html, json]\n  default_lang: all\n  safe_search: 1\noutgoing:\n  request_timeout: 3.0\n  max_request_timeout: 4.0\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "searxng",
        "namespace": "search-system"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "searxng"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "searxng"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 977,
              "runAsGroup": 977,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "searxng",
                "image": "harbor.k3s.local/internal/starbridge-searxng@sha256:a2325ad4b9f8648ef597c22d1df6d7faa0422d998d95bddd4be35c8e203a300f",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "80m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "384Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 30
                },
                "env": [
                  {
                    "name": "SEARXNG_SETTINGS_PATH",
                    "value": "/run/search/settings.yml"
                  },
                  {
                    "name": "SEARXNG_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "searxng-session",
                        "key": "secret"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "settings",
                    "mountPath": "/run/search",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "settings",
                "configMap": {
                  "name": "searxng-settings-v5"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "searxng",
        "namespace": "search-system"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "searxng"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "searxng",
        "namespace": "search-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "searxng"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "search-gateway"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "0.0.0.0/0",
                  "except": [
                    "0.0.0.0/8",
                    "10.0.0.0/8",
                    "100.64.0.0/10",
                    "127.0.0.0/8",
                    "169.254.0.0/16",
                    "172.16.0.0/12",
                    "192.0.0.0/24",
                    "192.168.0.0/16",
                    "198.18.0.0/15",
                    "224.0.0.0/3"
                  ]
                }
              }
            ],
            "ports": [
              {
                "port": 443,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "search-gateway",
        "namespace": "search-system"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "search-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "search-gateway"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "gateway",
                "image": "harbor.k3s.local/internal/starbridge-search-gateway@sha256:770ee7fb1f19d8112de16791fd3173555e04455199cbc5d1b574fc6bf2fdbece",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "env": [
                  {
                    "name": "PYTHONDONTWRITEBYTECODE",
                    "value": "1"
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "30m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "300m",
                    "memory": "192Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "search-gateway",
        "namespace": "search-system"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "search-gateway"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "search-gateway",
        "namespace": "search-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "search-gateway"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "search-gateway"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/managed-by": "platform-control"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "codechat.io/project-tool": "true"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "searxng"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ]
}
